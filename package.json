{
  "name": "varmar-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 expo customize tsconfig.json && tsc --noEmit && tsc -p supabase/functions",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:rules": "node scripts/check-lint-rules.mjs",
    "format": "prettier --write .",
    "new:feature": "node scripts/new-feature.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\" \"supabase/functions/**/*.test.ts\"",
    "sb": "node scripts/supabase.mjs",
    "test:db": "node scripts/db-test.mjs",
    "db:push": "node scripts/supabase.mjs db push --remote --yes",
    "db:lint": "node scripts/supabase.mjs db lint --remote --fail-on warning",
    "db:advisors": "node scripts/db-advisors.mjs",
    "db:perf": "node scripts/db-perf.mjs",
    "db:types": "node scripts/db-types.mjs write",
    "db:types:check": "node scripts/db-types.mjs check",
    "db:check": "node scripts/db-check.mjs",
    "test:auth": "node --test supabase/tests/auth.e2e.test.mjs",
    "functions:deploy": "node scripts/functions-deploy.mjs",
    "owner": "node scripts/owner.mjs",
    "auth:config": "node scripts/supabase.mjs config push --yes"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo/ui": "~58.0.29",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/query-async-storage-persister": "^5.108.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-query-persist-client": "^5.108.0",
    "aes-js": "^3.1.2",
    "date-fns": "^4.4.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@expo/ngrok": "^4.1.3",
    "@tanstack/eslint-plugin-query": "^5.108.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.26",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "globals": "^17.14.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "lefthook": "^2.2.2",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-react-native-a11y>eslint": "9"
      }
    }
  }
}
