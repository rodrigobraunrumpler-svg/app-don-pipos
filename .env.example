# Copia este archivo como .env.local y complétalo. La app lo usa desde la fase 2.
# .env.local nunca entra al repositorio.
#
# La llave es la PUBLICABLE (empieza con sb_publishable_). La secreta (sb_secret_) nunca va aquí:
# todo lo que empieza con EXPO_PUBLIC_ queda dentro de la app y cualquiera puede leerlo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
