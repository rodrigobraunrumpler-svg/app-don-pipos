# Copia este archivo como .env.local y complétalo. La app lo usa desde la fase 2.
# .env.local nunca entra al repositorio.
#
# La llave es la PUBLICABLE (empieza con sb_publishable_). La secreta (sb_secret_) nunca va aquí:
# todo lo que empieza con EXPO_PUBLIC_ queda dentro de la app y cualquiera puede leerlo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Contraseña de la base de datos (SECRETA). Solo en .env.local; nunca lleva EXPO_PUBLIC_.
# La usan las migraciones y las pruebas de la base. Si tiene símbolos, ponla entre comillas simples.
SUPABASE_DB_PASSWORD=

# Proyecto de desarrollo: lo único que las herramientas pueden cambiar, probar o reiniciar
SUPABASE_DEV_PROJECT_REF=

# Secreto de las contraseñas internas de los dueños (SECRETO). Lo genera pnpm functions:deploy la primera vez.
# Cambiarlo deja a los dueños sin entrar hasta un pnpm owner reset-pin.
AUTH_PASSWORD_SECRET=

# Dueño DEMO del proyecto de desarrollo: lo escribe pnpm owner create --demo (el PIN no se imprime)
DEMO_OWNER_PHONE=
DEMO_OWNER_PIN=

# WhatsApp del equipo para «Olvidé mi PIN»: solo números, con el código del país. Sin él, esos botones no se muestran.
EXPO_PUBLIC_SUPPORT_WHATSAPP=
